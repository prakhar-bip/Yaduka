# PostgreSQL Database URL
# Format: postgresql://username:password@localhost:5432/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yaduka_db

# Fallback development SQLite database if PostgreSQL server is not locally running
FALLBACK_SQLITE_URL=sqlite:///./yaduka.db

# Application Configuration
APP_NAME=Yaduka Strategic Growth Engine
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
