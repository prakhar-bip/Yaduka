# ==========================================
# Yaduka Strategic Growth Engine — Environment Template
# ==========================================

# Application Settings
APP_NAME=Yaduka Strategic Growth Engine
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Database Settings (Dual PostgreSQL / SQLite fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yaduka_db
FALLBACK_SQLITE_URL=sqlite:///./yaduka.db

# LLM Reasoning Engine (Optional for offline mock mode)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# AWS Track Configuration (LocalStack / AWS Cloud)
AWS_DEFAULT_REGION=us-east-1
LOCALSTACK_ENDPOINT=http://localhost:4566
OPENSEARCH_ENDPOINT=http://localhost:9200
